---
interface Props {
  label?: string;
  ratio?: string;
  class?: string;
}

const { label = 'Image placeholder', ratio = '16 / 9', class: className } = Astro.props;
---

<div class:list={['image-placeholder', className]} style={`aspect-ratio: ${ratio};`}>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="1.5"></rect>
    <circle cx="8.5" cy="9.5" r="1.75"></circle>
    <path d="M21 16.5l-5.5-5.5-9.5 9.5"></path>
  </svg>
  <span>{label}</span>
</div>

<style>
  .image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    background: var(--color-bg-alt);
    border: 3px solid var(--color-accent);
    border-radius: 4px;
    color: var(--color-text-muted);
    box-sizing: border-box;
  }

  .image-placeholder span {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: center;
    padding: 0 var(--space-2);
  }
</style>
