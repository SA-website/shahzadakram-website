---
import { TOPICS } from '../content.config';

const year = new Date().getFullYear();

const exploreLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Work', href: '/work' },
  { label: 'Blog', href: '/blog' },
  { label: 'Services', href: '/services' },
  { label: 'Contact', href: '/contact' },
];

const topicLinks = Object.entries(TOPICS).map(([slug, data]) => ({
  label: data.label,
  href: `/seo/${slug}`,
}));

const connectLinks = [
  { label: 'Email', href: 'mailto:contact@shahzadakram.com' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/shahzad-akram-b8159b5b/' },
];

const legalLinks = [
  { label: 'Sitemap', href: '/sitemap' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms & Conditions', href: '/terms' },
];
---

<footer class="site-footer">
  <div class="wrapper site-footer__grid">
    <div class="site-footer__col">
      <p class="site-footer__heading">Explore</p>
      <ul>
        {exploreLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col">
      <p class="site-footer__heading">SEO Guides</p>
      <ul>
        {topicLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col">
      <p class="site-footer__heading">Connect</p>
      <ul>
        {connectLinks.map((link) => (
          <li>
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="wrapper site-footer__bottom">
    <p class="text-muted">&copy; {year} Shahzad Akram.</p>
    <ul class="site-footer__legal">
      {legalLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-6);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .site-footer__heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .site-footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer__col a {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    padding-bottom: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__legal {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-2);
  }

  .site-footer__legal a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-footer__legal a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
