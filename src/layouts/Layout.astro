---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  pageTitle?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Shahzad Akram — SEO, ventures, and writing about both.',
  pageTitle: pageTitleOverride,
  ogImage = '/og-image.png',
} = Astro.props;
const pageTitle = pageTitleOverride ?? (title === 'Shahzad Akram' ? title : `${title} · Shahzad Akram`);
const ogImageUrl = new URL(ogImage, Astro.site);
const siteUrl = new URL('/', Astro.site).toString();

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Shahzad Akram',
      url: siteUrl,
      jobTitle: 'Head of SEO & Digital Growth',
      sameAs: ['https://www.linkedin.com/in/shahzadakram'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Shahzad Akram',
      description: 'Shahzad Akram — SEO, ventures, and writing about both.',
      publisher: { '@id': `${siteUrl}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
