---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const services = [
  { name: 'Franchise SEO', text: 'Search strategy across national websites, local pages and franchise recruitment platforms.', href: '/franchise-seo/' },
  { name: 'Local & Multi-Location SEO', text: 'Useful location pages, accurate business information and clearer local enquiry journeys.', href: '/services/multi-location-seo/' },
  {
    name: 'GA4 tracking audits', href: '/contact/',
    text: "The exact work behind the Shilajit UK case study — checking whether your analytics actually reflect what's happening in the business, not just whether the tag fires.",
  },
  {
    name: 'Technical SEO audits', href: '/franchise-seo/#technical-seo',
    text: 'Crawl, indexation, site architecture, internal linking, and migration risk — the foundation issues that quietly cap everything else.',
  },
];
---

<Layout title="Services" description="Franchise SEO, multi-location search, technical SEO and GA4 tracking audits from Shahzad Akram.">
  <section class="wrapper prose page-header">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
    <p class="eyebrow">Services</p>
    <h1>SEO support for your business</h1>
    <p class="text-muted">
      I help franchise and multi-location businesses improve search visibility and website performance. I also offer focused technical SEO and GA4 tracking audits.
    </p>
  </section>

  <section class="wrapper services-list">
    {
      services.map((service) => (
        <div class="service-card">
          <h2>{service.name}</h2>
          <p class="text-muted">{service.text}</p>
          <a href={service.href}>Explore {service.name} &rarr;</a>
        </div>
      ))
    }
  </section>

  <section class="wrapper prose contact-cta">
    <h2>Get in touch</h2>
    <p class="text-muted">Send a message and I'll reply myself.</p>
    <a class="button" href="/contact">Contact me</a>
  </section>
</Layout>

<style>
  .page-header {
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .services-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-5);
  }

  .service-card {
    padding: var(--space-3);
    border-top: 2px solid var(--color-primary);
  }

  .contact-cta {
    padding-bottom: var(--space-6);
  }

  @media (max-width: 640px) {
    .services-list {
      grid-template-columns: 1fr;
    }
  }
</style>
