---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';

const marqueeItems = [
  'Franchise & Multi-Location SEO',
  'Franchise Recruitment SEO',
  'Technical SEO & Migrations',
  'SEO Consultancy & Leadership',
];

const entryCards = [
  {
    name: 'About',
    text: 'SEO experience built through doing the work — career history and how I approach a project.',
    href: '/about',
    cta: 'Read more',
  },
  {
    name: 'Work',
    text: 'Case studies from client work and my own e-commerce business, Shilajit UK.',
    href: '/work',
    cta: 'See the work',
  },
  {
    name: 'Blog',
    text: "Field notes, honest case studies, and ideas I'm assessing in public.",
    href: '/blog',
    cta: 'Read the blog',
  },
];

const stats = [
  { value: '6', label: 'Websites across a multi-brand portfolio' },
  { value: '191 + 335', label: 'Physical store pages and virtual service office pages' },
  { value: '9', label: 'Major website launches and migrations across the UK, US and Australia' },
];

const serviceIntros = [
  {
    heading: 'Help customers find the appropriate location',
    text: 'National service pages, location pages, Google Business Profiles and service-area content should work together. I help improve how customers discover your services, identify the appropriate location and move from search to a useful enquiry route.',
    cta: 'Explore local and multi-location SEO',
    href: '/services#franchise-multi-location-seo',
  },
  {
    heading: 'Help prospective franchisees understand the opportunity',
    text: 'Franchise recruitment serves a different audience. Prospective owners need clear information about the business model, investment, available territories, training, support and suitability before they are ready to enquire.\n\nI help organise recruitment websites around that decision journey, improving both organic discovery and the route to an informed enquiry.',
    cta: 'Explore franchise recruitment SEO',
    href: '/services#franchise-recruitment-seo',
  },
];

const serviceCategories = [
  {
    heading: 'Franchise and multi-location SEO',
    text: 'Create a joined-up search strategy across national services, locations and service areas. Identify gaps in local visibility and prioritise improvements across the network.',
  },
  {
    heading: 'Franchise recruitment SEO',
    text: 'Help prospective franchisees find and understand the opportunity through clearer website structure, useful content and a better-defined enquiry journey.',
  },
  {
    heading: 'Technical SEO and website migrations',
    text: 'Identify technical constraints or bring SEO into a rebuild before important decisions are fixed. Support can cover website architecture, URL planning, redirects, analytics, launch coordination and post-launch checks.',
  },
  {
    heading: 'SEO consultancy and leadership',
    text: 'Get experienced support with strategy, prioritisation, agency and developer coordination, implementation and meaningful performance reporting.',
  },
];

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Layout
  title="Shahzad Akram"
  pageTitle="Shahzad Akram | Franchise &amp; Multi-Location SEO"
  description="SEO for franchise and multi-location businesses. Shahzad Akram connects national search strategy, local visibility, franchise recruitment and website delivery."
>
  <section class="wrapper hero">
    <p class="eyebrow">Franchise &amp; multi-location SEO</p>
    <h1>SEO for franchise and multi-location businesses</h1>
    <p class="prose text-muted hero__lede">
      Help more customers find your locations—and more prospective franchisees discover your
      opportunity.
    </p>
    <p class="prose text-muted hero__lede">
      I'm Shahzad Akram. I help franchise and multi-location businesses connect national search
      strategy, local visibility, franchise recruitment and website delivery.
    </p>
    <p class="prose text-muted hero__lede">
      With more than 15 years' experience, I have led search strategy across World Options, Mail
      Boxes Etc. UK and PACK &amp; SEND UK, supporting six websites, approximately 191 physical
      store pages and 335 virtual service office pages.
    </p>
    <div class="hero__ctas">
      <a class="button" href="/contact">Discuss your project</a>
      <a class="button button--ghost" href="/work">Explore my work</a>
    </div>
  </section>

  <Marquee items={marqueeItems} />

  <section class="wrapper entry-cards">
    {
      entryCards.map((card) => (
        <a class="entry-card" href={card.href}>
          <h2>{card.name}</h2>
          <p class="text-muted">{card.text}</p>
          <span class="entry-card__link">
            &rarr; {card.cta}
          </span>
        </a>
      ))
    }
  </section>

  <section class="wrapper stats">
    <div class="stats__grid">
      {
        stats.map((stat) => (
          <div class="stat">
            <p class="stat__value">{stat.value}</p>
            <p class="stat__label">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <blockquote class="stats__note">
      The work involves more than optimising individual pages. It means understanding how
      national services, local locations, franchise recruitment, website platforms and enquiry
      journeys fit together—and helping the people responsible for delivery move the right work
      forward.
    </blockquote>
  </section>

  <section class="wrapper prose breakdown">
    <p class="eyebrow">Where the work starts</p>
    <h2>Where franchise SEO usually breaks down</h2>
    <p class="text-muted">
      Franchise SEO rarely fails because nobody can identify anything to improve. It often breaks
      down between the people, platforms and priorities involved.
    </p>
    <p class="text-muted">
      Head office controls the brand. Franchisees need local visibility. Agencies make
      recommendations. Developers manage implementation. Different websites may serve customers,
      locations and prospective franchisees, while network-wide reporting can make it difficult to
      see which areas actually benefit.
    </p>
    <p class="text-muted">
      I help connect those parts: identifying the real constraint, setting practical priorities,
      clarifying responsibilities and helping agreed improvements reach the live website.
    </p>
  </section>

  <section class="wrapper service-intro">
    <p class="eyebrow">Search growth across the whole franchise network</p>
    <h2 class="service-intro__heading">Two audiences, one website</h2>
    <div class="service-intro__grid">
      {
        serviceIntros.map((item) => (
          <div class="service-intro__card">
            <h3>{item.heading}</h3>
            {item.text.split('\n\n').map((para) => (
              <p class="text-muted">{para}</p>
            ))}
            <a class="link-arrow" href={item.href}>
              {item.cta} &rarr;
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrapper service-categories">
    <p class="eyebrow">Services</p>
    <h2 class="service-categories__heading">Where I help</h2>
    <div class="service-categories__grid">
      {
        serviceCategories.map((item) => (
          <div class="service-category">
            <h3>{item.heading}</h3>
            <p class="text-muted">{item.text}</p>
          </div>
        ))
      }
    </div>
    <a class="link-arrow" href="/services">See all services &rarr;</a>
  </section>

  <section class="wrapper prose case-study-strip">
    <p class="eyebrow">Featured</p>
    <h2>Practical experience on both sides of the website</h2>
    <p class="text-muted">
      Alongside employed SEO leadership roles, I built and operated Shilajit UK on Shopify. That
      meant responsibility not only for the website and marketing, but also sourcing, inventory,
      fulfilment, customer service and the accuracy of the information used to make commercial
      decisions.
    </p>
    <p class="text-muted">
      That experience changed how I approach SEO and analytics. Rankings and traffic matter, but
      so do enquiry quality, conversion measurement, operational capacity and whether the figures
      accurately represent what is happening inside the business.
    </p>
    <div class="case-study-strip__ctas">
      <a class="link-arrow" href="/work/shilajit-uk">Read the Shilajit UK case study &rarr;</a>
      <a class="link-arrow" href="/about">More about me &rarr;</a>
    </div>
  </section>

  <section class="wrapper blog-teaser">
    <p class="eyebrow">From the blog</p>
    <h2>Latest from the blog</h2>
    <div class="links-out">
      {
        latestPosts.map((post) => (
          <a class="link-card" href={`/blog/${post.id}`}>
            <span class="link-card__title">{post.data.title}</span>
            <span class="link-card__text">{post.data.description}</span>
            <span class="link-card__arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ))
      }
    </div>
    <a class="button button--ghost" href="/blog">View all posts</a>
  </section>

  <section class="wrapper prose footer-cta">
    <p class="eyebrow">Get in touch</p>
    <h2>Let's discuss what is preventing progress</h2>
    <p class="text-muted">
      Whether you manage a franchise network, are preparing for a website migration or need an
      experienced second opinion on search performance and measurement, tell me what you are
      working on.
    </p>
    <p class="text-muted">
      Share your website, the main problem and the people involved. I will reply personally so we
      can establish whether my experience fits the work.
    </p>
    <a class="button" href="/contact">Discuss your project</a>
  </section>
</Layout>

<style>
  .hero {
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
  }

  .hero h1 {
    margin-bottom: var(--space-3);
    max-width: 38rem;
  }

  .hero__lede {
    font-size: 1.2rem;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .entry-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .entry-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: var(--space-4);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .entry-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -16px rgba(38, 36, 32, 0.35);
  }

  .entry-card:hover h2 {
    color: var(--color-accent);
  }

  .entry-card p {
    margin-bottom: 0;
  }

  .entry-card__link {
    margin-top: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-accent);
  }

  .stats {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .stat {
    padding: var(--space-3);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-card);
  }

  .stat__value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 2.25rem;
    color: var(--color-primary);
    margin: 0 0 0.4rem;
    line-height: 1;
  }

  .stat__label {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .stats__note {
    max-width: var(--content-width);
    margin: 0;
  }

  .breakdown {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .service-intro {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .service-intro__heading {
    margin-bottom: var(--space-3);
  }

  .service-intro__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .service-intro__card {
    padding: var(--space-4);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-card);
  }

  .service-intro__card h3 {
    margin-bottom: 0.6rem;
  }

  .service-intro__card p {
    margin-bottom: var(--space-2);
  }

  .service-categories {
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .service-categories__heading {
    margin-bottom: var(--space-3);
  }

  .service-categories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .service-category {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .service-category h3 {
    margin-bottom: 0.5rem;
  }

  .service-category p {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }

  .case-study-strip {
    margin-top: var(--space-1);
    margin-bottom: var(--space-5);
    padding: var(--space-4);
    background-color: var(--color-primary);
    border-radius: var(--radius-card);
    max-width: none;
  }

  .case-study-strip .eyebrow,
  .case-study-strip h2 {
    color: var(--color-bg);
  }

  .case-study-strip .eyebrow::before {
    background-color: var(--color-accent-light);
  }

  .case-study-strip p.text-muted {
    color: var(--color-bg);
    opacity: 0.85;
    max-width: var(--content-width);
  }

  .case-study-strip .link-arrow {
    color: var(--color-bg);
  }

  .case-study-strip .link-arrow:hover {
    color: var(--color-accent-light);
  }

  .case-study-strip__ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .link-arrow {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
  }

  .blog-teaser {
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .links-out {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin: var(--space-3) 0 var(--space-4);
  }

  .link-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: var(--space-4);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .link-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -16px rgba(38, 36, 32, 0.35);
  }

  .link-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-primary);
  }

  .link-card:hover .link-card__title {
    color: var(--color-accent);
  }

  .link-card__text {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .link-card__arrow {
    color: var(--color-accent);
    font-family: var(--font-heading);
    margin-top: 0.5rem;
  }

  .footer-cta {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .footer-cta p.text-muted {
    max-width: var(--content-width);
  }

  @media (max-width: 800px) {
    .entry-cards,
    .stats__grid,
    .service-intro__grid,
    .service-categories__grid,
    .links-out {
      grid-template-columns: 1fr;
    }
  }
</style>
