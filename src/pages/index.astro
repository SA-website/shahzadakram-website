---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entryCards = [
  {
    name: 'About',
    text: "The real story — SEO career, ventures built, and what I've learned from the ones that didn't work.",
    href: '/about',
    cta: 'Read more',
  },
  {
    name: 'Work',
    text: 'Case studies from client work and my own e-commerce business, Shilajit UK.',
    href: '/work',
    cta: 'See the work',
  },
  {
    name: 'Blog',
    text: "Field notes, honest venture write-ups, and ideas I'm thinking through in public.",
    href: '/blog',
    cta: 'Read the blog',
  },
];

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const contactLinks = [
  { label: 'Email', value: 'contact@shahzadakram.com', href: 'mailto:contact@shahzadakram.com' },
  { label: 'LinkedIn', value: 'linkedin.com/in/shahzadakram', href: 'https://www.linkedin.com/in/shahzadakram' },
];
---

<Layout
  title="Shahzad Akram"
  pageTitle="Shahzad Akram | SEO, Digital Marketing & E-commerce"
  description="SEO and digital marketing insights from Shahzad Akram — real case studies, tracking audits, and lessons from building e-commerce ventures."
>
  <section class="wrapper hero">
    <p class="eyebrow">Shahzad Akram</p>
    <h1>Shahzad Akram</h1>
    <p class="prose text-muted hero__lede">
      SEO and digital marketing — case studies, audits, and honest lessons from building my own
      ventures.
    </p>
    <p class="prose text-muted hero__lede">
      I work across SEO, GA4 analytics, and e-commerce, and I write about what actually happens
      when you build things, including the parts that don't go to plan.
    </p>
    <div class="hero__ctas">
      <a class="button" href="/work">See the work</a>
      <a class="button button--ghost" href="/blog">Read the blog</a>
    </div>
  </section>

  <section class="wrapper entry-cards">
    {
      entryCards.map((card) => (
        <a class="entry-card" href={card.href}>
          <h2>{card.name}</h2>
          <p class="text-muted">{card.text}</p>
          <span class="entry-card__link">
            &rarr; {card.cta}
          </span>
        </a>
      ))
    }
  </section>

  <section class="wrapper prose case-study-strip">
    <p class="eyebrow">Featured</p>
    <h2>Shilajit UK</h2>
    <p class="text-muted">
      £430k in lifetime revenue, 10,800 customers — and a broken tracking setup that made a
      working business look like a failing one for months. Here's what I found and what I did
      about it.
    </p>
    <a class="link-arrow" href="/work/shilajit-uk">Read the case study &rarr;</a>
  </section>

  <section class="wrapper blog-teaser">
    <p class="eyebrow">From the blog</p>
    <h2>Latest from the blog</h2>
    <div class="links-out">
      {
        latestPosts.map((post) => (
          <a class="link-card" href={`/blog/${post.id}`}>
            <span class="link-card__title">{post.data.title}</span>
            <span class="link-card__text">{post.data.description}</span>
            <span class="link-card__arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ))
      }
    </div>
    <a class="button button--ghost" href="/blog">View all posts</a>
  </section>

  <section class="wrapper prose services-teaser">
    <p class="eyebrow">Services</p>
    <h2>Need this fixed on your own site?</h2>
    <p class="text-muted">
      I take on a limited number of GA4 tracking audits and technical SEO audits — the exact work
      behind the Shilajit UK case study.
    </p>
    <a class="link-arrow" href="/services">See services &rarr;</a>
  </section>

  <section class="wrapper prose footer-cta">
    <p class="eyebrow">Get in touch</p>
    <h2>Get in touch</h2>
    <div class="footer-cta__links">
      {
        contactLinks.map((link, i) => (
          <>
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {link.label}
            </a>
            {i < contactLinks.length - 1 && <span class="footer-cta__sep">&middot;</span>}
          </>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
  }

  .hero h1 {
    margin-bottom: var(--space-3);
  }

  .hero__lede {
    font-size: 1.2rem;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .entry-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-5);
  }

  .entry-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-3);
    border-top: 2px solid var(--color-primary);
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.15s ease;
  }

  .entry-card:hover {
    transform: translateY(-2px);
  }

  .entry-card:hover h2 {
    color: var(--color-accent);
  }

  .entry-card p {
    margin-bottom: 0;
  }

  .entry-card__link {
    margin-top: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-accent);
  }

  .case-study-strip {
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .link-arrow {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
  }

  .blog-teaser {
    padding-bottom: var(--space-5);
  }

  .links-out {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin: var(--space-3) 0 var(--space-4);
  }

  .link-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: var(--space-3);
    border-top: 2px solid var(--color-primary);
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.15s ease;
  }

  .link-card:hover {
    transform: translateY(-2px);
  }

  .link-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-primary);
  }

  .link-card:hover .link-card__title {
    color: var(--color-accent);
  }

  .link-card__text {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .link-card__arrow {
    color: var(--color-accent);
    font-family: var(--font-heading);
    margin-top: 0.5rem;
  }

  .services-teaser {
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .footer-cta {
    padding-bottom: var(--space-6);
  }

  .footer-cta__links {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-family: var(--font-heading);
    font-weight: 600;
    margin-top: var(--space-2);
  }

  .footer-cta__sep {
    color: var(--color-text-muted);
  }

  @media (max-width: 800px) {
    .entry-cards,
    .links-out {
      grid-template-columns: 1fr;
    }
  }
</style>
