---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const visuals = { 'world-options-franchise-seo': 'world-options', 'mail-boxes-etc-seo': 'mail-boxes-etc', 'pack-send-seo': 'pack-send' };

const caseStudies = (await getCollection('work', ({ id, data }) => !data.draft && !id.startsWith('project-'))).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="SEO Work & Case Studies" description="SEO case studies from franchise businesses and ventures, with results, reporting context and my role in the work.">
  <section class="wrapper prose page-header">
    <p class="eyebrow">Work</p>
    <h1>SEO work, with the context behind the results.</h1>
    <p class="text-muted">
      Selected work from franchise businesses and ventures I have built. Each case study explains
      my role, the reported results and what those numbers can tell us.
    </p>
  </section>

  <section class="wrapper case-study-list">
    {
      caseStudies.map((entry) => (
        <a class="case-study-card" href={`/work/${entry.id}`}>
          {visuals[entry.id] && <img class="case-study-card__thumb" src={`/${visuals[entry.id]}-thumbnail.png`} alt={`${entry.data.title} — reported organic traffic results`} width="1200" height="800" loading="lazy" />}
          <div class="case-study-card__content">
            <div class="case-study-card__meta">
              {entry.data.year && <span>{entry.data.year}</span>}
              {entry.data.role && <span>{entry.data.role}</span>}
            </div>
            <h2>{entry.data.title}</h2>
            <p class="text-muted">{entry.data.summary}</p>
            <span class="case-study-card__link">Read the case study &rarr;</span>
          </div>
        </a>
      ))
    }
  </section>
  <section class="wrapper prose page-header">
    <h2>How to read these results</h2>
    <p>Organic visits, search impressions and revenue measure different things. The case studies identify the reporting period and my role, and distinguish traffic growth from enquiries or sales. Work completed in employed roles involved colleagues and delivery partners.</p>
    <h2>Discuss your website</h2>
    <p>I help franchise and multi-location businesses connect SEO priorities with practical delivery.</p>
    <p><a href="/contact/">Tell me about your website</a></p>
  </section>
</Layout>

<style>
  .page-header {
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .case-study-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-2);
    padding-bottom: var(--space-6);
  }

  .case-study-card {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
    gap: var(--space-3);
    align-items: start;
    text-decoration: none;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .case-study-card {
      grid-template-columns: 1fr;
    }
  }

  .case-study-card__meta {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .case-study-card h2 {
    margin-bottom: 0.5rem;
  }

  .case-study-card:hover h2 {
    color: var(--color-accent);
  }

  .case-study-card p {
    max-width: 42rem;
    margin-bottom: 0.75rem;
  }

  .case-study-card__link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-primary);
  }
  .case-study-card:has(.case-study-card__thumb) { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
  .case-study-card__thumb { width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: 12px; }
  @media(max-width:640px) { .case-study-card:has(.case-study-card__thumb) { grid-template-columns: 1fr; } }
</style>
