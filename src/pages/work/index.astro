---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const caseStudies = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Work" description="Case studies from the ventures and projects I've built.">
  <section class="wrapper prose page-header">
    <p class="eyebrow">Work</p>
    <h1>A portfolio of what actually shipped.</h1>
    <p class="text-muted">
      Deep-dive case studies, not logos on a slide. Each one covers the problem, the approach,
      what happened, and what I'd do differently.
    </p>
  </section>

  <section class="wrapper case-study-list">
    {
      caseStudies.map((entry) => (
        <a class="case-study-card" href={`/work/${entry.id}`}>
          <div class="case-study-card__meta">
            {entry.data.year && <span>{entry.data.year}</span>}
            {entry.data.role && <span>{entry.data.role}</span>}
          </div>
          <h2>{entry.data.title}</h2>
          <p class="text-muted">{entry.data.summary}</p>
          <span class="case-study-card__link">Read the case study &rarr;</span>
        </a>
      ))
    }
  </section>
</Layout>

<style>
  .page-header {
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .case-study-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-2);
    padding-bottom: var(--space-6);
  }

  .case-study-card {
    display: block;
    text-decoration: none;
    color: var(--color-text);
  }

  .case-study-card__meta {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .case-study-card h2 {
    margin-bottom: 0.5rem;
  }

  .case-study-card:hover h2 {
    color: var(--color-accent);
  }

  .case-study-card p {
    max-width: 42rem;
    margin-bottom: 0.75rem;
  }

  .case-study-card__link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-primary);
  }
</style>
