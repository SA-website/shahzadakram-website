---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { TOPICS } from '../../content.config';

export async function getStaticPaths() {
  const caseStudies = await getCollection('work', ({ data }) => !data.draft);
  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  about: entry.data.summary,
  author: { '@type': 'Person', name: 'Shahzad Akram', url: new URL('/', Astro.site).toString() },
  url: new URL(`/work/${entry.id}`, Astro.site).toString(),
};
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <article class="wrapper prose case-study">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Work', href: '/work' }, { label: entry.data.title }]} />
    <p class="eyebrow"><a href="/work">Work</a></p>
    <div class="case-study__meta">
      {entry.data.year && <span>{entry.data.year}</span>}
      {entry.data.role && <span>{entry.data.role}</span>}
    </div>
    <h1>{entry.data.title}</h1>
    <p class="text-muted case-study__summary">{entry.data.summary}</p>
    {
      entry.data.topics.length > 0 && (
        <div class="case-study__topics">
          {entry.data.topics.map((topic) => (
            <a class="case-study__topic" href={`/seo/${topic}`}>
              {TOPICS[topic].label}
            </a>
          ))}
        </div>
      )
    }
    <ImagePlaceholder
      class="case-study__hero"
      ratio="16 / 9"
      label={`${entry.data.title} — hero image`}
    />
    <div class="case-study__body">
      <Content />
    </div>
  </article>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .case-study {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .case-study__meta {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .case-study__summary {
    font-size: 1.2rem;
  }

  .case-study__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-2);
  }

  .case-study__topic {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--color-primary);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: 0.3em 0.75em;
    border-radius: 3px;
    text-decoration: none;
  }

  .case-study__hero {
    margin-top: var(--space-4);
  }

  .case-study__body {
    margin-top: var(--space-4);
  }

  .case-study__body h2 {
    margin-top: var(--space-4);
  }
</style>
