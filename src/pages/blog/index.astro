---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { PILLARS } from '../../content.config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const pillarOrder = Object.keys(PILLARS) as (keyof typeof PILLARS)[];

const groups = pillarOrder.map((key) => ({
  key,
  ...PILLARS[key],
  posts: allPosts
    .filter((post) => post.data.pillar === key)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
}));

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' });
---

<Layout title="Blog" description="Field Notes, Built & Broken, and Idea Log — writing organised by pillar.">
  <section class="wrapper prose page-header">
    <p class="eyebrow">Blog</p>
    <h1>Writing organised by what it's for, not when it was posted.</h1>
  </section>

  <section class="wrapper pillars">
    {
      groups.map((group) => (
        <div class="pillar">
          <div class="pillar__header">
            <h2>{group.label}</h2>
            <p class="text-muted pillar__description">{group.description}</p>
          </div>
          <div class="pillar__posts">
            {group.posts.length === 0 && <p class="text-muted pillar__empty">Nothing published yet.</p>}
            {
              group.posts.map((post) => (
                <a class="post-row" href={`/blog/${post.id}`}>
                  <span class="post-row__title">{post.data.title}</span>
                  <span class="post-row__date">{dateFormat.format(post.data.pubDate)}</span>
                </a>
              ))
            }
          </div>
        </div>
      )
      )
    }
  </section>
</Layout>

<style>
  .page-header {
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .pillars {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .pillar {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: var(--space-4);
  }

  .pillar__header h2 {
    margin-bottom: 0.5rem;
  }

  .pillar__description {
    max-width: 22rem;
  }

  .pillar__posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-1);
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-heading);
  }

  .post-row__title {
    font-weight: 500;
  }

  .post-row:hover .post-row__title {
    color: var(--color-accent);
  }

  .post-row__date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .pillar__empty {
    padding: var(--space-2) 0;
  }

  @media (max-width: 800px) {
    .pillar {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
